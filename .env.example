# Copy to .env next to compose.yaml and edit. Every NAS_FILES_* variable the service or
# compose.yaml uses is listed here (a test enforces it).

# DSM user id and group id of the dedicated "nas-files" user (run `id nas-files` over SSH,
# or see the README). The container runs as this user.
NAS_FILES_UID=1026
NAS_FILES_GID=100

# The one host port the service is published on (plain HTTP; see ADR-0002).
NAS_FILES_HOST_PORT=8080

# Listen address inside the container. Leave as is unless you know why.
NAS_FILES_ADDR=0.0.0.0:8080

# Data directory inside the container; its sub-folders are the Mounts. compose.yaml
# mounts each shared folder under /data. Leave as is.
NAS_FILES_ROOT=/data

# Refuse a Mount that is not its own mount point. Keep true on the NAS; false only for
# running locally without Docker.
NAS_FILES_REQUIRE_MOUNT_POINTS=true

# Users file inside the container: htpasswd format with bcrypt hashes, one "name:hash"
# line per User. compose.yaml mounts it read-only. Create entries on a Mac with
# `htpasswd -nBC 10 <user>` and paste the line into the file. Leave the path as is.
NAS_FILES_USERS_FILE=/config/users.htpasswd

# Access file inside the container: JSON, {"<user>": {"<mount>": "read" | "write" | "none"}}.
# Anything not listed is none, and a Mount a User has no Access to does not exist for them.
# A Mount mounted ":ro" caps everyone at read. Every <user> must be in the users file and
# every <mount> must be a Mount, or the service refuses to start. Example:
#   {"<user>": {"<mount>": "write", "<archive-mount>": "read"}}
# compose.yaml mounts it read-only. Leave the path as is.
NAS_FILES_ACCESS_FILE=/config/access.json

# Days deleted and replaced files stay in each Mount's Trash (.nas-files-trash) before they
# are purged. 0 keeps them forever. Recover files from the Trash with File Station.
NAS_FILES_TRASH_RETENTION_DAYS=30
